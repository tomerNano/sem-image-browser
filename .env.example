# Copy to .env (never commit it). Use the dedicated read-only B2 application key.
AWS_ACCESS_KEY_ID=YOUR_READ_ONLY_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_READ_ONLY_APPLICATION_KEY
B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=YOUR_BUCKET
B2_RAW_PREFIX=yeast
HOST=127.0.0.1
PORT=3000
CACHE_DIR=./.cache-images
