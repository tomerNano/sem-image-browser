# Copy to .env (never commit it). Use the dedicated read-only B2 application key.
AWS_ACCESS_KEY_ID=YOUR_READ_ONLY_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_READ_ONLY_APPLICATION_KEY
B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=YOUR_BUCKET
B2_RAW_PREFIX=yeast
# Loopback only (127.0.0.1, ::1 or localhost): the server refuses anything else until sign-in exists.
HOST=127.0.0.1
PORT=3000
CACHE_DIR=./.cache-images
# Cache size limit in megabytes (default 2048). Above it, the least recently used images are deleted.
CACHE_MAX_MB=2048
# Log detail: debug (every B2 call, cache hit and render), info (default), warn or error.
LOG_LEVEL=info
# Log file, relative to the repository root; "off" = console only.
LOG_FILE=logs/server.log
# Optional: Registry metadata (Nanoscout/data-registry, branch main): catalog/yeast/images.csv
# (image metadata) and split_tags.csv in the same folder (split tags).
# Metadata columns, filters and tags stay empty without it.
# GitHub (recommended): a fine-grained token with access to data-registry only, Contents: Read-only.
# The same token reads both files. The server checks GitHub once a minute and picks up new commits
# by itself.
REGISTRY_GITHUB_TOKEN=
# Defaults; change only if the Registry moves. split_tags.csv is always read from the folder of
# REGISTRY_GITHUB_PATH.
# REGISTRY_GITHUB_REPO=Nanoscout/data-registry
# REGISTRY_GITHUB_REF=main
# REGISTRY_GITHUB_PATH=catalog/yeast/images.csv
# Local override for development: images.csv in a clone (split_tags.csv next to it). When set, it
# wins over the token.
# REGISTRY_CSV_PATH=C:/path/to/data-registry/catalog/yeast/images.csv
