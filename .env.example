# Copy to .env (never commit it). Use the dedicated read-only B2 application key.
AWS_ACCESS_KEY_ID=YOUR_READ_ONLY_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_READ_ONLY_APPLICATION_KEY
B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=YOUR_BUCKET
B2_RAW_PREFIX=yeast
# Loopback only (127.0.0.1, ::1 or localhost): the server refuses anything else until sign-in exists.
HOST=127.0.0.1
PORT=3000
CACHE_DIR=./.cache-images
# Optional: images.csv in a local clone of the Registry (Nanoscout/data-registry, branch v1).
# Metadata columns and filters stay empty without it. Run `git pull` in the clone to update.
REGISTRY_CSV_PATH=C:/path/to/data-registry/catalog/yeast/images.csv
